        // Input Masks and Formatting Script
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🎭 Initializing input masks...');
            
            // Phone Number Mask - (000) 000-0000
            function phoneMask(input) {
                input.addEventListener('input', function(e) {
                    let value = e.target.value.replace(/\D/g, '');
                    
                    if (value.length > 10) {
                        value = value.slice(0, 10);
                    }
                    
                    let formatted = '';
                    if (value.length > 0) {
                        formatted = '(' + value.substring(0, 3);
                        if (value.length >= 3) {
                            formatted += ') ' + value.substring(3, 6);
                        }
                        if (value.length >= 6) {
                            formatted += '-' + value.substring(6, 10);
                        }
                    }
                    
                    e.target.value = formatted;
                });
            }
            
            // Date of Birth Mask - MM/DD/YYYY
            function dateMask(input) {
                input.addEventListener('input', function(e) {
                    let value = e.target.value.replace(/\D/g, '');
                    
                    if (value.length > 8) {
                        value = value.slice(0, 8);
                    }
                    
                    let formatted = '';
                    if (value.length > 0) {
                        formatted = value.substring(0, 2);
                        if (value.length >= 2) {
                            formatted += '/' + value.substring(2, 4);
                        }
                        if (value.length >= 4) {
                            formatted += '/' + value.substring(4, 8);
                        }
                    }
                    
                    e.target.value = formatted;
                });
                
                // Validate date on blur
                input.addEventListener('blur', function(e) {
                    const value = e.target.value;
                    if (value && value.length === 10) {
                        const parts = value.split('/');
                        const month = parseInt(parts[0]);
                        const day = parseInt(parts[1]);
                        const year = parseInt(parts[2]);
                        
                        let isValid = true;
                        
                        // Basic validation
                        if (month < 1 || month > 12) isValid = false;
                        if (day < 1 || day > 31) isValid = false;
                        if (year < 1900 || year > new Date().getFullYear()) isValid = false;
                        
                        // Age validation (must be at least 18)
                        const birthDate = new Date(year, month - 1, day);
                        const today = new Date();
                        const age = today.getFullYear() - birthDate.getFullYear();
                        const monthDiff = today.getMonth() - birthDate.getMonth();
                        
                        if (age < 18 || (age === 18 && monthDiff < 0) || 
                            (age === 18 && monthDiff === 0 && today.getDate() < birthDate.getDate())) {
                            isValid = false;
                            const errorDiv = document.getElementById('date_of_birth-error');
                            if (errorDiv) {
                                errorDiv.textContent = 'You must be at least 18 years old';
                                errorDiv.style.display = 'block';
                            }
                        } else {
                            const errorDiv = document.getElementById('date_of_birth-error');
                            if (errorDiv) {
                                errorDiv.style.display = 'none';
                            }
                        }
                        
                        if (!isValid) {
                            e.target.style.borderColor = '#dc3545';
                        } else {
                            e.target.style.borderColor = '';
                        }
                    }
                });
            }
            
            // SSN Mask - 000-00-0000
            function ssnMask(input) {
                input.addEventListener('input', function(e) {
                    let value = e.target.value.replace(/\D/g, '');
                    
                    if (value.length > 9) {
                        value = value.slice(0, 9);
                    }
                    
                    let formatted = '';
                    if (value.length > 0) {
                        formatted = value.substring(0, 3);
                        if (value.length >= 3) {
                            formatted += '-' + value.substring(3, 5);
                        }
                        if (value.length >= 5) {
                            formatted += '-' + value.substring(5, 9);
                        }
                    }
                    
                    e.target.value = formatted;
                });
            }
            
            // Apply masks to inputs
            const cellPhone = document.getElementById('cell_phone');
            const homePhone = document.getElementById('home_phone');
            const employerPhone = document.getElementById('employer_phone');
            const dateOfBirth = document.getElementById('date_of_birth');
            const ssn = document.getElementById('ssn');
            
            if (cellPhone) {
                phoneMask(cellPhone);
                console.log('✅ Cell phone mask applied');
            }
            
            if (homePhone) {
                phoneMask(homePhone);
                console.log('✅ Home phone mask applied');
            }
            
            if (employerPhone) {
                phoneMask(employerPhone);
                console.log('✅ Employer phone mask applied');
            }
            
            if (dateOfBirth) {
                dateMask(dateOfBirth);
                console.log('✅ Date of birth mask applied');
            }
            
            if (ssn) {
                ssnMask(ssn);
                console.log('✅ SSN mask applied');
            }
            
            // SSN checkbox toggle
            const noSsnCheckbox = document.getElementById('no_ssn');
            const ssnInput = document.getElementById('ssn');
            const noSsnReasonContainer = document.getElementById('no_ssn_reason_container');
            const noSsnReasonSelect = document.getElementById('no_ssn_reason');
            
            if (noSsnCheckbox) {
                noSsnCheckbox.addEventListener('change', function() {
                    if (this.checked) {
                        // Hide SSN input, show reason
                        ssnInput.value = '';
                        ssnInput.removeAttribute('required');
                        ssnInput.disabled = true;
                        ssnInput.style.backgroundColor = '#f8f9fa';
                        
                        noSsnReasonContainer.style.display = 'block';
                        noSsnReasonSelect.setAttribute('required', 'required');
                        
                        console.log('🔒 SSN input disabled, reason required');
                    } else {
                        // Show SSN input, hide reason
                        ssnInput.setAttribute('required', 'required');
                        ssnInput.disabled = false;
                        ssnInput.style.backgroundColor = '';
                        
                        noSsnReasonContainer.style.display = 'none';
                        noSsnReasonSelect.removeAttribute('required');
                        noSsnReasonSelect.value = '';
                        
                        console.log('🔓 SSN input enabled');
                    }
                });
                
                console.log('✅ SSN checkbox handler attached');
            }
            
            console.log('✅ All input masks initialized successfully');
        });
        
        // Searchable State Select Script
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🔍 Initializing searchable state selects...');
            
            // Function to make a select searchable
            function makeSelectSearchable(selectElement) {
                if (!selectElement) return;
                
                const wrapper = document.createElement('div');
