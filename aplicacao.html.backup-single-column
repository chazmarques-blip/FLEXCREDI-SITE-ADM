    <!-- ZIP Code Auto-fill Script - Enhanced -->
    <script>
        // Wait for DOM and all other scripts
        window.addEventListener('load', function() {
            
            // ========== DATE OF BIRTH RESTRICTIONS ==========
            const birthDateInput = document.getElementById('data_nascimento');
            
            if (birthDateInput) {
                const today = new Date();
                const maxDate = new Date(today.getFullYear() - 18, today.getMonth(), today.getDate());
                const minDate = new Date(today.getFullYear() - 100, today.getMonth(), today.getDate());
                
                // Format dates as YYYY-MM-DD
                const formatDate = (date) => {
                    const year = date.getFullYear();
                    const month = String(date.getMonth() + 1).padStart(2, '0');
                    const day = String(date.getDate()).padStart(2, '0');
                    return `${year}-${month}-${day}`;
                };
                
                birthDateInput.setAttribute('max', formatDate(maxDate)); // 18 years ago
                birthDateInput.setAttribute('min', formatDate(minDate)); // 100 years ago
                
                console.log('Birth date restrictions set:', {
                    max: formatDate(maxDate),
                    min: formatDate(minDate)
                });
                
                // Validation on change
                birthDateInput.addEventListener('change', function() {
                    const selectedDate = new Date(this.value);
                    const age = Math.floor((today - selectedDate) / (365.25 * 24 * 60 * 60 * 1000));
                    
                    if (age < 18) {
                        alert('You must be at least 18 years old to apply.');
                        this.value = '';
                    } else if (age > 100) {
                        alert('Please enter a valid date of birth.');
                        this.value = '';
                    } else {
                        console.log('Age:', age, 'years old');
                    }
                });
            }
            
            // ========== AUTO UPPERCASE ALL TEXT INPUTS ==========
            const textInputs = document.querySelectorAll('input[type="text"], input[type="tel"], textarea');
            
            textInputs.forEach(input => {
                // Skip email fields
                if (input.type === 'email') return;
                
                input.addEventListener('input', function() {
                    const start = this.selectionStart;
                    const end = this.selectionEnd;
                    
                    this.value = this.value.toUpperCase();
                    
                    // Restore cursor position
                    this.setSelectionRange(start, end);
                });
            });
            
            // Ensure email stays lowercase
            const emailInputs = document.querySelectorAll('input[type="email"]');
            emailInputs.forEach(input => {
                input.addEventListener('input', function() {
                    const start = this.selectionStart;
                    const end = this.selectionEnd;
                    
                    this.value = this.value.toLowerCase();
                    
                    this.setSelectionRange(start, end);
                });
            });
            
            console.log('Auto-uppercase enabled for', textInputs.length, 'text fields');
            console.log('Auto-lowercase enabled for', emailInputs.length, 'email fields');
            
            // ========== ALTERNATIVE DOCUMENT TOGGLE ==========
            const useAltDocCheckbox = document.getElementById('use_alternative_doc');
            const ssnInput = document.getElementById('ssn');
            const altDocSection = document.getElementById('alternative_doc_section');
            const altDocNumberSection = document.getElementById('alternative_doc_number_section');
            const altDocTypeSelect = document.getElementById('alternative_doc_type');
            const altDocNumberInput = document.getElementById('alternative_doc_number');
            
            if (useAltDocCheckbox) {
                useAltDocCheckbox.addEventListener('change', function() {
                    if (this.checked) {
                        // Hide SSN/Tax ID and show alternative document fields
                        ssnInput.value = '';
                        ssnInput.removeAttribute('required');
                        ssnInput.closest('.form-group').style.display = 'none';
                        
                        altDocSection.style.display = 'block';
                        altDocNumberSection.style.display = 'block';
                        altDocTypeSelect.setAttribute('required', 'required');
                        altDocNumberInput.setAttribute('required', 'required');
                        
                        console.log('✓ Using alternative document');
                    } else {
                        // Show SSN/Tax ID and hide alternative document fields
                        ssnInput.closest('.form-group').style.display = 'block';
                        ssnInput.setAttribute('required', 'required');
                        
                        altDocSection.style.display = 'none';
                        altDocNumberSection.style.display = 'none';
                        altDocTypeSelect.removeAttribute('required');
                        altDocNumberInput.removeAttribute('required');
                        altDocTypeSelect.value = '';
                        altDocNumberInput.value = '';
                        
                        console.log('✓ Using SSN/Tax ID');
                    }
                });
            }
            
            // ========== ZIP CODE AUTO-FILL ==========
            console.log('ZIP auto-fill script loaded');
            
            const zipInput = document.getElementById('zip_code');
            const cityInput = document.getElementById('city');
            const stateInput = document.getElementById('state');
            
            console.log('Elements found:', {
                zip: !!zipInput,
                city: !!cityInput,
                state: !!stateInput
            });
            
            if (!zipInput || !cityInput || !stateInput) {
                console.error('ZIP auto-fill: Required elements not found');
                return;
            }
            
            // Remove readonly temporarily to allow manual input
            cityInput.removeAttribute('readonly');
            stateInput.removeAttribute('readonly');
            
            // Auto-fill on ZIP blur
            zipInput.addEventListener('blur', async function() {
                const zip = this.value.replace(/\D/g, '');
                console.log('ZIP blur event, value:', zip);
                
                if (zip.length === 5) {
                    console.log('Fetching data for ZIP:', zip);
                    
                    try {
                        const apiUrl = `https://api.zippopotam.us/us/${zip}`;
                        console.log('API URL:', apiUrl);
                        
                        const response = await fetch(apiUrl);
                        console.log('API response status:', response.status);
                        
                        if (response.ok) {
                            const data = await response.json();
                            console.log('API data:', data);
                            
                            if (data.places && data.places.length > 0) {
                                const place = data.places[0];
                                
                                cityInput.value = place['place name'];
                                stateInput.value = place['state abbreviation'];
                                
                                // DO NOT make readonly - allow manual editing
                                // cityInput.setAttribute('readonly', 'readonly');
                                // stateInput.setAttribute('readonly', 'readonly');
                                
                                // Visual feedback
                                cityInput.style.borderColor = '#2ECC71';
                                stateInput.style.borderColor = '#2ECC71';
                                cityInput.style.background = '#f0fdf4';
                                stateInput.style.background = '#f0fdf4';
                                
                                console.log('Auto-filled:', {
                                    city: cityInput.value,
                                    state: stateInput.value
                                });
                                
                                setTimeout(() => {
                                    cityInput.style.borderColor = '';
                                    stateInput.style.borderColor = '';
                                    cityInput.style.background = '';
                                    stateInput.style.background = '';
                                }, 2000);
                            }
                        } else {
                            console.error('Invalid ZIP code response');
                            cityInput.value = '';
                            stateInput.value = '';
                            
                            // Show user-friendly message
                            const errorMsg = document.createElement('div');
                            errorMsg.style.color = '#E74C3C';
                            errorMsg.style.fontSize = '12px';
                            errorMsg.style.marginTop = '4px';
                            errorMsg.textContent = 'ZIP code not found. Please enter manually.';
                            zipInput.parentNode.appendChild(errorMsg);
                            
                            setTimeout(() => errorMsg.remove(), 3000);
                        }
                    } catch (error) {
                        console.error('Error fetching ZIP data:', error);
                        
                        // Fallback: allow manual entry
                        cityInput.removeAttribute('readonly');
                        stateInput.removeAttribute('readonly');
                    }
                }
            });
            
            // Also trigger on Enter key
            zipInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    zipInput.blur();
                }
            });
            
            // ZIP code formatting
            zipInput.addEventListener('input', function(e) {
                let value = e.target.value.replace(/\D/g, '');
                if (value.length > 5) {
                    value = value.slice(0, 5) + '-' + value.slice(5, 9);
                }
                e.target.value = value;
            });
            
            console.log('ZIP auto-fill initialized successfully');
        });
    </script>
    
