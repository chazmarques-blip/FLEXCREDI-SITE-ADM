# FLEXCREDI BACKEND - VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha os valores

# BANCO DE DADOS
DATABASE_URL="postgresql://username:password@host:port/database"

# SEGURANÇA
JWT_SECRET="seu_jwt_secret_muito_seguro_aqui_min_32_caracteres"
BCRYPT_ROUNDS=12

# SERVIDOR
PORT=3001
NODE_ENV=development

# CLOUDINARY (Storage de Arquivos)
CLOUDINARY_CLOUD_NAME="seu_cloud_name"
CLOUDINARY_API_KEY="sua_api_key"
CLOUDINARY_API_SECRET="sua_api_secret"

# EMAIL (Notificações)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="seu@email.com"
EMAIL_PASS="sua_senha_app"

# ADMIN PADRÃO
DEFAULT_ADMIN_EMAIL="admin@flexcredi.com"
DEFAULT_ADMIN_PASSWORD="FlexCredi2024!"

# INTEGRAÇÕES FUTURAS
SERASA_API_KEY=""
EXPERIAN_API_KEY=""
WEBHOOK_SECRET=""

# CONFIGURAÇÕES GERAIS
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="image/jpeg,image/png,application/pdf"
BACKUP_ENABLED=true
LOG_LEVEL=info