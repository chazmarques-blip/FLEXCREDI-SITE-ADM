# FLEXCREDI BACKEND - CONFIGURAÇÕES DE PRODUÇÃO
NODE_ENV=production

# CONFIGURAÇÕES DE SEGURANÇA (produção) - ALTERAR PARA VALORES SEGUROS!
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_JWT_SECRET_KEY_VERY_SECURE
BCRYPT_ROUNDS=12

# ADMIN PADRÃO - ALTERAR SENHA EM PRODUÇÃO!
DEFAULT_ADMIN_EMAIL=admin@flexcredi.com
DEFAULT_ADMIN_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION

# CONFIGURAÇÕES GERAIS
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# FRONTEND URL (será definido após deploy do Vercel)
FRONTEND_URL=https://flexcredi.vercel.app

# DATABASE (futuro)
# DATABASE_URL=